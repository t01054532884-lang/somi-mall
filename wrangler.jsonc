// Cloudflare Workers 배포 설정. D1 database_id는 `wrangler d1 create somimall-db`로 만든 뒤 넣는다.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shop",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    { "pattern": "choose-c.com", "custom_domain": true },
    { "pattern": "www.choose-c.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "somimall-db",
      "database_id": "c8166428-e659-43c3-b1b4-7220f372d23b",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "somimall-images"
    }
  ],
  "observability": { "enabled": true }
}
