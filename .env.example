# Google Cloud Console에서 만든 웹 애플리케이션 OAuth 정보
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kakao Developers 웹 앱의 REST API 키와 Client Secret
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 32바이트 이상의 무작위 문자열. 운영 환경에서는 Sites의 비밀 설정에 저장합니다.
AUTH_SECRET=

# 기존 소미몰 운영자 화면용 ChatGPT 사용자 ID
ADMIN_USER_ID=
ADMIN_EMAIL=
