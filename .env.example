# Google Cloud Console에서 만든 웹 애플리케이션 OAuth 정보
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kakao Developers 웹 앱의 REST API 키와 Client Secret
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# NAVER Developers 애플리케이션의 Client ID와 Client Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 32바이트 이상의 무작위 문자열. 운영 환경에서는 Cloudflare Worker 비밀 값(secret)으로 저장합니다.
AUTH_SECRET=

# 관리자 화면(/admin) 아이디·비밀번호 로그인. ADMIN_SESSION_TOKEN은 32바이트 이상의 무작위 문자열입니다.
ADMIN_LOGIN_ID=
ADMIN_LOGIN_PASSWORD=
ADMIN_SESSION_TOKEN=

# 이 이메일로 인증된 회원 로그인(Google, 인증된 카카오 이메일)도 관리자로 인정합니다. 비워 두면 사용하지 않습니다.
ADMIN_EMAIL=

# traffic 대시보드 연동용 토큰 (traffic/mall-integration/README.md 참고)
TRAFFIC_EXPORT_TOKEN=
